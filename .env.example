# =============================================================================
# Konsulin Backend — Environment Configuration
# =============================================================================
#
# QUICKSTART
#   1. cp .env.example .env
#   2. docker compose up -d          (reads the same .env — single source of truth)
#   3. go run ./cmd/http
#
# LEGEND
#   Empty value = must be set (no safe default)
#   Commented out = optional — a safe default is baked into
#                   internal/app/config/config.go (shown inline)
#
# ENVIRONMENT GATING
#   APP_ENV selects the environment (local|dev|development|test|...).
#   Boot-time validation (validateNonDevConfig) only enforces the
#   "REQUIRED IN NON-LOCAL" section for non-local environments.

# =============================================================================
# 1. MINIMUM — copy & run locally
#    Values for REDIS match docker-compose.yml; change them together
#    in .env and the stack follows automatically.
# =============================================================================
APP_ENV=local
APP_JWT_SECRET=                              # 32+ char string used to sign JWTs; generate your own
SUPERADMIN_API_KEY=                          # superadmin access key for /auth/magiclink (401 if empty)
REDIS_PASSWORD=redispass                     # matches docker-compose.yml

# =============================================================================
# 2. REQUIRED IN NON-LOCAL — server refuses to boot if missing
#    Enforced by validateNonDevConfig / validateNonDevDriverConfig.
# =============================================================================
SUPERTOKEN_API_KEY=                          # SuperTokens core API key

# =============================================================================
# 3. FUNCTIONALLY REQUIRED — not boot-validated, but features break without them
# =============================================================================
APP_SUPERTOKEN_KONSULIN_DASHBOARD_ADMIN_EMAIL=  # breaks superadmin dashboard account provisioning

# =============================================================================
# 4. OPTIONAL — safe defaults baked into config.go; uncomment to override
# =============================================================================

# -- Application ---------------------------------------------------------------
# APP_PORT=3200
# APP_ADDRESS=localhost
# APP_VERSION=v1
# APP_BASE_URL=http://localhost:3000/api/v1
# APP_TIMEZONE=Asia/Jakarta
# APP_FRONTEND_DOMAIN=http://localhost:3000
# APP_ENDPOINT_PREFIX=api
# APP_MAX_REQUESTS=20
# SUPERADMIN_API_KEY_RATE_LIMIT=10           # superadmin requests per second

# -- Limits & Timeouts -----------------------------------------------------------
# APP_PAYMENT_EXPIRED_TIME_IN_MINUTES=60
# APP_SHUTDOWN_TIMEOUT_IN_SECONDS=30        # graceful shutdown budget for in-flight requests

# -- Infrastructure: Redis ---------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379

# -- Infrastructure: Logger ---------------------------------------------------------
# LOGGER_LEVEL=info
# LOGGER_OUTPUT_FILE_NAME=logger.log
# LOGGER_OUTPUT_ERROR_FILE_NAME=logger-error.log

# -- Auth: SuperTokens ----------------------------------------------------------------
# SUPERTOKEN_CONNECTION_URI=http://localhost:3567
# SUPERTOKEN_API_BASE_PATH=/auth
# SUPERTOKEN_WEBSITE_BASE_PATH=/auth
# SUPERTOKEN_APP_NAME=Konsulin
# SUPERTOKEN_API_DOMAIN=http://localhost:3000
# SUPERTOKEN_WEBSITE_DOMAIN=http://localhost:3000
# APP_SUPERTOKEN_KONSULIN_TENANT_ID=public

# -- Services: FHIR -------------------------------------------------------------------
# APP_FHIR_BASE_URL=http://localhost:8080/fhir/

# =============================================================================
# 5. GATEWAY / PARTY — federation mode (optional)
#    APP_GATEWAY_URL empty (default) = standalone mode: no APP_PARTY_* needed.
#    When set, APP_PARTY_ID, APP_PARTY_PRIVATE_KEY and APP_PARTY_ENC_PRIVATE_KEY
#    become mandatory — boot fails naming the missing variable.
#    Outside local/dev/development/test the URL must be https://.
#    Key values are never logged.
# =============================================================================
# APP_GATEWAY_URL=                          # gateway base URL; empty = standalone mode
# APP_PARTY_ID=                             # party ID issued out of band by the gateway admin
# APP_PARTY_PRIVATE_KEY=                    # Ed25519/ES256 signing key (PEM) — never logged
# APP_PARTY_ENC_PRIVATE_KEY=                # X25519 key opening JWE envelopes — never logged
# APP_PARTY_ENROLLMENT_TOKEN=               # single-use enrollment token from gateway admin
# APP_PARTY_NEXT_PRIVATE_KEY=               # next signing key for self-service rotation
# APP_PARTY_NEXT_ENC_PRIVATE_KEY=           # next enc key for self-service rotation
# APP_AUTOMATION_PARTY_ID=                  # automation provider party ID
# APP_SERVICE_PROVIDER_ALIASES=             # comma-separated alias=partyId list
# APP_PEPPER=                               # federation HMAC pepper (manual-delivery fallback) — never logged
# APP_RBAC_POLICY_PATH=resources/rbac_policy.csv
# APP_ORGANIZATION_NAME=Konsulin
# APP_DATA_DIR=./data                      # must be writable at startup (BK-CONF-002)

# =============================================================================
# 6. RESEARCH DATABANK — optional (BK-DATABANK)
#    APP_RESEARCH_PSEUDONYM_KEY empty (default) keeps the databank disabled.
#    APP_DATA_DIR must be writable at startup: boot fails naming it (BK-CONF-002).
# =============================================================================
# APP_AUTOPUBLISH=false                     # publish derived research resources without manual review
# APP_RESEARCH_PSEUDONYM_KEY=               # HMAC key for subject pseudonyms; empty = databank disabled — never logged
# APP_RESEARCH_EXPORT_MAX_BYTES=52428800    # cap for one sealed export (50 MiB)
