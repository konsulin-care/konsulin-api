# =============================================================================
# Konsulin Backend — Environment Configuration
# =============================================================================
#
# QUICKSTART
#   1. cp .env.example .env
#   2. docker compose up -d          (reads the same .env — single source of truth)
#   3. go run ./cmd/http
#
# LEGEND
#   Empty value = must be set (no safe default)
#   Commented out = optional — a safe default is baked into
#                   internal/app/config/config.go (shown inline)
#
# ENVIRONMENT GATING
#   APP_ENV selects the environment (local|dev|development|test|...).
#   Boot-time validation (validateNonDevConfig) only enforces the
#   "REQUIRED IN NON-LOCAL" section for non-local environments.

# =============================================================================
# 1. MINIMUM — copy & run locally
#    Values for REDIS/RABBITMQ match docker-compose.yml; change them together
#    in .env and the stack follows automatically.
# =============================================================================
APP_ENV=local
APP_JWT_SECRET=                              # 32+ char string used to sign JWTs; generate your own
SUPERADMIN_API_KEY=                          # superadmin access key for /auth/magiclink (401 if empty)
REDIS_PASSWORD=redispass                     # matches docker-compose.yml
RABBITMQ_USERNAME=guest                      # matches docker-compose.yml
RABBITMQ_PASSWORD=password                   # matches docker-compose.yml

# =============================================================================
# 2. REQUIRED IN NON-LOCAL — server refuses to boot if missing
#    Enforced by validateNonDevConfig / validateNonDevDriverConfig.
# =============================================================================
SUPERTOKEN_API_KEY=                          # SuperTokens core API key
JWT_HOOK_KEY=                                # EC private key (PEM) signing webhook payloads
APP_PAYMENT_GATEWAY_USERNAME=                # OY! Indonesia credentials
APP_PAYMENT_GATEWAY_API_KEY=                 # OY! Indonesia credentials
APP_PAYMENT_GATEWAY_BASE_URL=                # OY! Indonesia API base URL
APP_XENDIT_API_KEY=                          # Xendit SDK API key

# =============================================================================
# 3. FUNCTIONALLY REQUIRED — not boot-validated, but features break without them
# =============================================================================
APP_XENDIT_WEBHOOK_TOKEN=                    # breaks Xendit payment callback verification (401)
HOOK_URL=                                    # breaks the webhook service (external forwarding)
APP_SUPERTOKEN_KONSULIN_DASHBOARD_ADMIN_EMAIL=  # breaks superadmin dashboard account provisioning

# =============================================================================
# 4. OPTIONAL — safe defaults baked into config.go; uncomment to override
# =============================================================================

# -- Application ---------------------------------------------------------------
# APP_PORT=3200
# APP_ADDRESS=localhost
# APP_VERSION=v1
# APP_BASE_URL=http://localhost:3000/api/v1
# APP_TIMEZONE=Asia/Jakarta
# APP_FRONTEND_DOMAIN=http://localhost:3000
# APP_ENDPOINT_PREFIX=api
# APP_WEBHOOK_INSTANTIATE_BASE_PATH=hook
# APP_MAX_REQUESTS=20
# SUPERADMIN_API_KEY_RATE_LIMIT=10           # superadmin requests per second

# -- Limits & Timeouts -----------------------------------------------------------
# APP_PAYMENT_EXPIRED_TIME_IN_MINUTES=60
# APP_PAYMENT_GATEWAY_REQUEST_TIMEOUT_IN_SECONDS=120
# APP_SHUTDOWN_TIMEOUT_IN_SECONDS=30        # graceful shutdown budget for in-flight requests

# -- Infrastructure: Redis ---------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379

# -- Infrastructure: RabbitMQ ------------------------------------------------------
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672

# -- Infrastructure: Logger ---------------------------------------------------------
# LOGGER_LEVEL=info
# LOGGER_OUTPUT_FILE_NAME=logger.log
# LOGGER_OUTPUT_ERROR_FILE_NAME=logger-error.log

# -- Auth: SuperTokens ----------------------------------------------------------------
# SUPERTOKEN_CONNECTION_URI=http://localhost:3567
# SUPERTOKEN_API_BASE_PATH=/auth
# SUPERTOKEN_WEBSITE_BASE_PATH=/auth
# SUPERTOKEN_APP_NAME=Konsulin
# SUPERTOKEN_API_DOMAIN=http://localhost:3000
# SUPERTOKEN_WEBSITE_DOMAIN=http://localhost:3000
# APP_SUPERTOKEN_KONSULIN_TENANT_ID=public

# -- Services: FHIR -------------------------------------------------------------------
# APP_FHIR_BASE_URL=http://localhost:8080/fhir/
# APP_TERMINOLOGY_BASE_URL=https://tx.konsulin.care/fhir

# -- Pricing (IDR) ---------------------------------------------------------------------
# BASE_PRICE_ANALYZE=5000
# BASE_PRICE_REPORT=20000
# BASE_PRICE_PERFORMANCE_REPORT=50000
# BASE_PRICE_ACCESS_DATASET=100000

# -- Webhook Service (advanced) ----------------------------------------------------------
# HOOK_RATE_LIMIT=-1                          # -1 = disabled
# HOOK_QUOTA=-1                               # -1 = disabled
# HOOK_RATE_LIMITED_SERVICES=analyze,interpret
# HOOK_PAID_ONLY_SERVICES=analyze
# HOOK_ASYNC_SERVICE_NAMES=
# HOOK_SYNC_SERVICE_NAMES=analyze             # must be non-empty
# HOOK_SYNCHRONOUS_SERVICE_RATE_LIMIT=60
# HOOK_SYNCHRONOUS_SERVICE_WINDOW_SECONDS=60
# HOOK_SYNCHRONOUS_SERVICE_FAILURE_POLICY=return_error   # return_error | enqueue_request
# HOOK_MAX_QUEUE=150
# HOOK_THROTTLE_RETRY=3                       # failed-count threshold before DLQ
# HOOK_HTTP_TIMEOUT=5
# HOOK_JWT_ALG=ES256                          # ES256 | RS256

# -- Slot Worker (advanced) ----------------------------------------------------------------
# SLOT_WINDOW_DAYS=30
# SLOT_WORKER_CRON_SPEC=@daily
